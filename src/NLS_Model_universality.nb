Cell["NLS routine", "Subsection",
 CellChangeTimes->{{3.97809385670446*^9, 
  3.9780938620158195`*^9}},ExpressionUUID->"b0e0d48e-6fa7-f848-8347-\
ced3bf820755"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qNLS", "//", "Clear"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"qNLS", "[", 
    RowBox[{"x_", ",", "t_", ",", "nn_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"qNLS", "[", 
     RowBox[{"x", ",", "t", ",", "nn"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "ee\[Theta]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rhp2", "=", 
        RowBox[{
         RowBox[{"J", "[", 
          RowBox[{"x", ",", "t", ",", "nn"}], "]"}], "//", "MakeListFun"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"ee\[Theta]", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"u2", "=", " ", 
        RowBox[{"RHSolve", "[", "rhp2", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dom", " ", "=", " ", 
        RowBox[{"u2", "//", "DomainPlot"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"out2", " ", "=", " ", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"DomainIntegrate", "[", "u2", "]"}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "/", 
         RowBox[{"(", "Pi", " ", ")"}]}]}], ";", "\[IndentingNewLine]", 
       "out2"}]}], "\[IndentingNewLine]", "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"0ec79ad2-030e-0a41-897d-9d8a52f07829"]
}, Open  ]],

