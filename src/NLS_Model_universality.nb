Cell[BoxData[{
 RowBox[{
  RowBox[{"qNLS", "//", "Clear"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"qNLS", "[", 
    RowBox[{"x_", ",", "t_", ",", "nn_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"qNLS", "[", 
     RowBox[{"x", ",", "t", ",", "nn"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "ee\[Theta]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rhp2", "=", 
        RowBox[{
         RowBox[{"J", "[", 
          RowBox[{"x", ",", "t", ",", "nn"}], "]"}], "//", "MakeListFun"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"ee\[Theta]", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"u2", "=", " ", 
        RowBox[{"RHSolve", "[", "rhp2", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dom", " ", "=", " ", 
        RowBox[{"u2", "//", "DomainPlot"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"out2", " ", "=", " ", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"DomainIntegrate", "[", "u2", "]"}], ")"}], "[", 
