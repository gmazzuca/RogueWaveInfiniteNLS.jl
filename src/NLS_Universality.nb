Cell[CellGroupData[{

Cell["PV - Initial data", "Subsection",
 CellChangeTimes->{{3.9780927427340584`*^9, 
  3.9780927457993507`*^9}},ExpressionUUID->"856f3266-8e36-1d48-a7d7-\
0ce6f62dde51"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "Parameter", " ", "for", " ", "the", 
    " ", "Chi", " ", "Distribution", " ", "and", " ", "zeta"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nu", "=", "4"}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Zeta]", "=", "0.3"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Define", " ", "the", " ", "analytical", " ", "mean", " ", 
     "of", " ", "the", " ", "Chi", " ", "Distribution", " ", "for", " ", 
     "muD"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Mean", " ", "of", " ", "Chi", 
      RowBox[{"(", "nu", ")"}]}], "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", "2", "]"}], "*", "Gamma", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nu", "+", "1"}], ")"}], "/", "2"}], ")"}], "/", "Gamma"}], 
      RowBox[{"(", 
       RowBox[{"nu", "/", "2"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"muDCalculated", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", "2", "]"}], "*", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nu", "+", "1"}], ")"}], "/", "2"}], "]"}], "/", 
       RowBox[{"Gamma", "[", 
        RowBox[{"nu", "/", "2"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "4.", " ", "Loop", " ", "over", " ", "the", " ", "requested", " ", 
      "Soliton", " ", 
      RowBox[{"numbers", ":", "50"}]}], ",", "100", ",", "200"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solitonCounts", "=", 
     RowBox[{"{", 
      RowBox[{"100", ",", "200"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", 
          RowBox[{"A", ".", "Setup"}]}]}], " ", "Parameters", " ", "for", " ",
         "this", " ", 
        RowBox[{"Iteration", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Nsoliton", "=", "currentN"}], ";", "\[IndentingNewLine]", 
       RowBox[{"muD", "=", "muDCalculated"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", 
            RowBox[{"B", ".", "Generate"}]}]}], " ", "Random", " ", 
          RowBox[{"ks", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ks", "=", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"RandomVariate", "[", 
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"0", ",", "15"}], "]"}], "]"}], "+", 
            RowBox[{"\[Zeta]", " ", "*", "i"}], " ", "+", 
            RowBox[{"I", "*", 
             RowBox[{"RandomVariate", "[", 
              RowBox[{"ChiDistribution", "[", "nu", "]"}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "Nsoliton"}], "}"}]}], "]"}], "//", 
         "sp"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", 
            RowBox[{"C", ".", "Calculate"}]}]}], " ", "Norming", " ", 
          "Constants", " ", 
          RowBox[{
           RowBox[{"(", "cs", ")"}], "--"}]}], "-"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"cs", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ks", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "-", 
               RowBox[{"cc", "[", 
                RowBox[{"ks", "[", 
                 RowBox[{"[", "n", "]"}], "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "1", ",", 
                RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}], "/", 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ks", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "-", 
               RowBox[{"ks", "[", 
                RowBox[{"[", "n", "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "1", ",", 
                RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}]}], "/", 
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ks", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "-", 
              RowBox[{"ks", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", 
               RowBox[{"j", "+", "1"}], ",", 
               RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", 
            RowBox[{"D", ".", "Generate"}]}]}], " ", 
          RowBox[{"Data", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"xx", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"2", "/", 
               RowBox[{"(", 
                RowBox[{"Nsoliton", " ", "muD"}], ")"}]}], "*", 
              RowBox[{"sol", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"2", " ", "xx"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"Nsoliton", " ", "muD"}], ")"}]}], ",", "0"}], 
               "]"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"xx", ",", 
            RowBox[{"-", "4"}], ",", "4", ",", 
            RowBox[{"1", "/", "100"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", 
            RowBox[{"E", ".", "Plotting"}]}]}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Optional", ":", 
             RowBox[{"to", " ", "see", " ", "progress"}]}], ")"}], "--"}]}], 
         "-"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"printPlot", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"data", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<N = \>\"", ",", "Nsoliton"}], "}"}], "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "printPlot", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", 
            RowBox[{"F", ".", "Export"}]}]}], " ", "to", " ", 
          RowBox[{"CSV", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fileName", "=", 
        RowBox[{
         RowBox[{"ToString", "[", "Nsoliton", "]"}], 
         "<>", "\"\<solitonPV.csv\>\""}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"path", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", "fileName"}], "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"path", ",", "data"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Exported: \>\"", ",", "path"}], "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"currentN", ",", "solitonCounts"}], "}"}]}], " ", 
     RowBox[{"(*", 
      RowBox[{"End", " ", "of", " ", "Do", " ", "Loop"}], "*)"}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9780927576442184`*^9, 3.9780927920269337`*^9}, {
  3.978092839045328*^9, 3.9780928708881035`*^9}, {3.978095757634981*^9, 
  3.978095787845068*^9}},ExpressionUUID->"6d0c8d18-6bfd-914d-8016-\
f4abcfb4b20c"],

