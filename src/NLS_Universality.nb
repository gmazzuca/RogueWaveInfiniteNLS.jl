            RowBox[{"C", ".", "Calculate"}]}]}], " ", "Norming", " ", 
          "Constants", " ", 
          RowBox[{
           RowBox[{"(", "cs", ")"}], "--"}]}], "-"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"cs", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ks", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "-", 
               RowBox[{"cc", "[", 
                RowBox[{"ks", "[", 
                 RowBox[{"[", "n", "]"}], "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "1", ",", 
                RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}], "/", 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ks", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "-", 
               RowBox[{"ks", "[", 
                RowBox[{"[", "n", "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "1", ",", 
                RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}]}], "/", 
           RowBox[{"Product", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ks", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "-", 
              RowBox[{"ks", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", 
               RowBox[{"j", "+", "1"}], ",", 
               RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", 
            RowBox[{"D", ".", "Generate"}]}]}], " ", 
          RowBox[{"Data", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"xx", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"2", "/", 
               RowBox[{"(", 
                RowBox[{"Nsoliton", " ", "muD"}], ")"}]}], "*", 
              RowBox[{"sol", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"2", " ", "xx"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"Nsoliton", " ", "muD"}], ")"}]}], ",", "0"}], 
               "]"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"xx", ",", 
            RowBox[{"-", "4"}], ",", "4", ",", 
            RowBox[{"1", "/", "100"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", 
            RowBox[{"E", ".", "Plotting"}]}]}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Optional", ":", 
             RowBox[{"to", " ", "see", " ", "progress"}]}], ")"}], "--"}]}], 
         "-"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"printPlot", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"data", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<N = \>\"", ",", "Nsoliton"}], "}"}], "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "printPlot", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", 
            RowBox[{"F", ".", "Export"}]}]}], " ", "to", " ", 
          RowBox[{"CSV", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"fileName", "=", 
        RowBox[{
         RowBox[{"ToString", "[", "Nsoliton", "]"}], 
         "<>", "\"\<solitonPIII.csv\>\""}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"path", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", "fileName"}], "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"path", ",", "data"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Exported: \>\"", ",", "path"}], "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"currentN", ",", "solitonCounts"}], "}"}]}], " ", 
     RowBox[{"(*", 
      RowBox[{"End", " ", "of", " ", "Do", " ", "Loop"}], "*)"}], "]"}], 
    ";"}]}]}]], "Input",
