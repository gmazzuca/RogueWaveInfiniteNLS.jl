Cell[CellGroupData[{

Cell["PIII data with averages", "Subsection",
 CellChangeTimes->{{3.978200465139101*^9, 
  3.978200472774851*^9}},ExpressionUUID->"e0dbd668-927c-174f-ad33-\
0725002681d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Setup", " ", "Parameters"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"nu", "=", "4"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"muDCalculated", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", "2", "]"}], "*", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nu", "+", "1"}], ")"}], "/", "2"}], "]"}], "/", 
       RowBox[{"Gamma", "[", 
        RowBox[{"nu", "/", "2"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"solitonCounts", "=", 
     RowBox[{"{", 
      RowBox[{"50", ",", "100", ",", "200"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"NEW", ":", 
     RowBox[{
     "Define", " ", "how", " ", "many", " ", "realizations", " ", "to", " ", 
      "average", " ", "over"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numRealizations", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Main"}]}], " ", "Loop", " ", "over", " ", "Soliton", " ",
       "Numbers", " ", 
      RowBox[{
       RowBox[{"(", "N", ")"}], "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Nsoliton", "=", "currentN"}], ";", "\[IndentingNewLine]", 
       RowBox[{"muD", "=", "muDCalculated"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Initialize", " ", "a", " ", "list", " ", "to", " ", "accumulate", " ",
           "the", " ", "y"}], "-", 
         RowBox[{"values", " ", "for", " ", "averaging", " ", 
          RowBox[{"later", "."}]}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"The", " ", "size", " ", "801", " ", "comes", " ", "from", " ", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "4"}], ",", "4", ",", 
           RowBox[{"1", "/", "100"}]}], "]"}]}], "*)"}], 
       RowBox[{"accumulatedY", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.0", ",", "801"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", "Inner"}]}], " ", "Loop", " ", "over", " ", 
          "Realizations", " ", 
          RowBox[{
           RowBox[{"(", "Trials", ")"}], "--"}]}], "-"}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"A", ".", "Generate"}], " ", "Random", " ", "ks"}], "*)"}], 
        RowBox[{
         RowBox[{
          RowBox[{"ks", "=", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"RandomVariate", "[", 
                RowBox[{"NormalDistribution", "[", 
                 RowBox[{"0", ",", "15"}], "]"}], "]"}], "+", 
               RowBox[{"I", "*", 
                RowBox[{"RandomVariate", "[", 
                 RowBox[{"ChiDistribution", "[", "nu", "]"}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "Nsoliton"}], "}"}]}], "]"}], "//",
             "sp"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"B", ".", "Calculate"}], " ", "Norming", " ", "Constants",
             " ", 
            RowBox[{"(", "cs", ")"}]}], "*)"}], 
          RowBox[{"cs", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Product", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ks", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "-", 
                  RowBox[{"cc", "[", 
                   RowBox[{"ks", "[", 
                    RowBox[{"[", "n", "]"}], "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"n", ",", "1", ",", 
                   RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}], "/", 
               RowBox[{"Product", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ks", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "-", 
                  RowBox[{"ks", "[", 
                   RowBox[{"[", "n", "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"n", ",", "1", ",", 
                   RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}]}], "/", 
              RowBox[{"Product", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ks", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "-", 
                 RowBox[{"ks", "[", 
                  RowBox[{"[", "n", "]"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"n", ",", 
                  RowBox[{"j", "+", "1"}], ",", 
                  RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"C", ".", "Generate"}], " ", "Data", " ", "for", " ", 
            "this", " ", "Trial"}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{"Note", ":", 
            RowBox[{
             RowBox[{"Assuming", "'"}], 
             RowBox[{"sol", "'"}], " ", "function", " ", "is", " ", "defined",
              " ", "elsewhere", " ", "in", " ", "your", " ", "notebook"}]}], 
           "*)"}], 
          RowBox[{"data", "=", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"xx", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"2", "/", 
                  RowBox[{"(", 
                   RowBox[{"Nsoliton", " ", "muD"}], ")"}]}], "*", 
                 RowBox[{"sol", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", " ", "xx"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"Nsoliton", " ", "muD"}], ")"}]}], ",", "0"}], 
                  "]"}]}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"xx", ",", 
               RowBox[{"-", "4"}], ",", "4", ",", 
               RowBox[{"1", "/", "100"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"D", ".", "Accumulate"}], " ", "Data", " ", "for", " ", 
            "Averaging"}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"We", " ", "add", " ", "the", " ", "y"}], "-", 
            RowBox[{"values", " ", 
             RowBox[{"(", 
              RowBox[{"Part", " ", "2", " ", "of", " ", "data"}], ")"}], " ", 
             "to", " ", "our", " ", "running", " ", "total"}]}], "*)"}], 
          RowBox[{"accumulatedY", "=", 
           RowBox[{"accumulatedY", "+", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"E", ".", "Export"}], " ", "Intermediate", " ", "Trial", " ",
             "Data"}], "*)"}], 
          RowBox[{"fileNameTrial", "=", 
           RowBox[{
            RowBox[{"ToString", "[", "Nsoliton", "]"}], 
            "<>", "\"\<solitonPIII_trial\>\"", "<>", 
            RowBox[{"ToString", "[", "trial", "]"}], "<>", "\"\<.csv\>\""}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"pathTrial", "=", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"NotebookDirectory", "[", "]"}], ",", "fileNameTrial"}],
              "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{"pathTrial", ",", "data"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Optional", ":", 
            RowBox[{
            "Print", " ", "progress", " ", "for", " ", "individual", " ", 
             "trials"}]}], "*)"}], 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<N=\>\"", ",", "Nsoliton", ",", "\"\< | Trial \>\"", ",",
             "trial", ",", "\"\</\>\"", ",", "numRealizations", 
            ",", "\"\< exported.\>\""}], "]"}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"trial", ",", "1", ",", "numRealizations"}], "}"}]}], "]"}],
        ";", 
       RowBox[{"(*", 
        RowBox[{"End", " ", "of", " ", "Inner", " ", "Loop"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", "Calculate"}]}], " ", "Average", " ", "and", " ", 
          "Export", " ", 
          RowBox[{"Final", "--"}]}], "-"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"1.", " ", "Compute", " ", "average", " ", "Y"}], "*)"}], 
       RowBox[{"averagedY", "=", 
        RowBox[{"accumulatedY", "/", "numRealizations"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "2.", " ", "Reconstruct", " ", "the", " ", "dataset", " ", "using", " ",
           "the", " ", "same", " ", "x"}], "-", "grid"}], "*)"}], 
       RowBox[{"xGrid", "=", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "4"}], ",", "4", ",", 
          RowBox[{"1", "/", "100"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"finalAveragedData", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"xGrid", ",", "averagedY"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "3.", " ", "Plot", " ", "the", " ", "Averaged", " ", "Result"}], 
        "*)"}], 
       RowBox[{"printPlot", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"finalAveragedData", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             
             RowBox[{"\"\<N = \>\"", ",", "Nsoliton", ",", "\"\< (Avg of \>\"",
               ",", "numRealizations", ",", "\"\<)\>\""}], "}"}], "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "printPlot", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"4.", " ", "Export", " ", "Averaged", " ", "Data"}], "*)"}], 
       RowBox[{"fileNameAvg", "=", 
        RowBox[{
         RowBox[{"ToString", "[", "Nsoliton", "]"}], 
         "<>", "\"\<solitonPIII_AVERAGED.csv\>\""}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pathAvg", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", "fileNameAvg"}], 
          "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"pathAvg", ",", "finalAveragedData"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Final Average Exported: \>\"", ",", "pathAvg"}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<---------------------------------------\>\"", "]"}],
        ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"currentN", ",", "solitonCounts"}], "}"}]}], "]"}], 
    ";"}]}]}]], "Input",
