Cell[CellGroupData[{

Cell["P-V average", "Subsection",
 CellChangeTimes->{{3.9782020053076687`*^9, 
  3.9782020083040943`*^9}},ExpressionUUID->"4acdd3bc-da25-a941-bfe6-\
4f9ad5a5e3eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Setup", " ", "Parameters"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"nu", "=", "4"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"muDCalculated", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", "2", "]"}], "*", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nu", "+", "1"}], ")"}], "/", "2"}], "]"}], "/", 
       RowBox[{"Gamma", "[", 
        RowBox[{"nu", "/", "2"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"solitonCounts", "=", 
     RowBox[{"{", "200", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Zeta]", "=", "0.3"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"NEW", ":", 
     RowBox[{
     "Define", " ", "how", " ", "many", " ", "realizations", " ", "to", " ", 
      "average", " ", "over"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numRealizations", "=", "10"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", 
          RowBox[{"A", ".", "Setup"}]}]}], " ", "Parameters", " ", "for", " ",
         "this", " ", 
        RowBox[{"N", "--"}]}], "-"}], "*)"}], 
     RowBox[{
      RowBox[{
       RowBox[{"Nsoliton", "=", "currentN"}], ";", "\[IndentingNewLine]", 
       RowBox[{"muD", "=", "muDCalculated"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Initialize", " ", "Accumulator", " ", "for", " ", "the", " ", 
         "Averaging"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"Grid", " ", "is"}], "-", 
          RowBox[{"4", " ", "to", " ", "4", " ", "step", " ", "0.01"}]}], "=", 
         RowBox[{"801", " ", "points"}]}], "*)"}], 
       RowBox[{"accumulatedY", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.0", ",", "801"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", 
           RowBox[{"B", ".", "Inner"}]}]}], " ", 
         RowBox[{"Loop", ":", 
          RowBox[{
           RowBox[{"Realizations", "--"}], "-"}]}]}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{"(*", 
         RowBox[{
         "Generate", " ", "Random", " ", "ks", " ", "with", " ", "Zeta", " ", 
          "shift"}], "*)"}], 
        RowBox[{
         RowBox[{
          RowBox[{"ks", "=", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"RandomVariate", "[", 
                RowBox[{"NormalDistribution", "[", 
                 RowBox[{"0", ",", "15"}], "]"}], "]"}], "+", 
               RowBox[{"\[Zeta]", "*", "i"}], "+", 
               RowBox[{"I", "*", 
                RowBox[{"RandomVariate", "[", 
                 RowBox[{"ChiDistribution", "[", "nu", "]"}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "Nsoliton"}], "}"}]}], "]"}], "//",
             "sp"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Calculate", " ", "Norming", " ", "Constants", " ", 
            RowBox[{"(", "cs", ")"}]}], "*)"}], 
          RowBox[{"cs", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Product", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ks", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "-", 
                  RowBox[{"cc", "[", 
                   RowBox[{"ks", "[", 
                    RowBox[{"[", "n", "]"}], "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"n", ",", "1", ",", 
                   RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}], "/", 
               RowBox[{"Product", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ks", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "-", 
                  RowBox[{"ks", "[", 
                   RowBox[{"[", "n", "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"n", ",", "1", ",", 
                   RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}]}], "/", 
              RowBox[{"Product", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ks", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "-", 
                 RowBox[{"ks", "[", 
                  RowBox[{"[", "n", "]"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"n", ",", 
                  RowBox[{"j", "+", "1"}], ",", 
                  RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"Length", "[", "ks", "]"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Generate", " ", "Data"}], "*)"}], 
          RowBox[{"data", "=", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"xx", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"2", "/", 
                  RowBox[{"(", 
                   RowBox[{"Nsoliton", " ", "muD"}], ")"}]}], "*", 
                 RowBox[{"sol", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", " ", "xx"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"Nsoliton", " ", "muD"}], ")"}]}], ",", "0"}], 
                  "]"}]}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"xx", ",", 
               RowBox[{"-", "4"}], ",", "4", ",", 
               RowBox[{"1", "/", "100"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Accumulate", " ", "for", " ", "Average"}], "*)"}], 
          RowBox[{"accumulatedY", "=", 
           RowBox[{"accumulatedY", "+", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{"--", 
              RowBox[{"-", 
               RowBox[{"C", ".", "Export"}]}]}], " ", "Intermediate", " ", 
             RowBox[{"Trial", "--"}]}], "-"}], "*)"}], 
          RowBox[{"fileNameTrial", "=", 
           RowBox[{
            RowBox[{"ToString", "[", "Nsoliton", "]"}], 
            "<>", "\"\<solitonPV_trial\>\"", "<>", 
            RowBox[{"ToString", "[", "trial", "]"}], "<>", "\"\<.csv\>\""}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"pathTrial", "=", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"NotebookDirectory", "[", "]"}], ",", "fileNameTrial"}],
              "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{"pathTrial", ",", "data"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Progress", " ", "Print"}], "*)"}], 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<N=\>\"", ",", "Nsoliton", ",", "\"\< | Trial \>\"", ",",
             "trial", ",", "\"\< exported.\>\""}], "]"}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"trial", ",", "1", ",", "numRealizations"}], "}"}]}], "]"}],
        ";", 
       RowBox[{"(*", 
        RowBox[{"End", " ", "Inner", " ", "Loop"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", 
            RowBox[{"D", ".", "Calculate"}]}]}], " ", "Average", " ", "and", " ",
           "Export", " ", 
          RowBox[{"Final", "--"}]}], "-"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"Compute", " ", "Mean"}], "*)"}], 
       RowBox[{"averagedY", "=", 
        RowBox[{"accumulatedY", "/", "numRealizations"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Rebuild", " ", "Grid", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "4"}], ",", "4", ",", "0.01"}], "}"}]}], "*)"}], 
       RowBox[{"xGrid", "=", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "4"}], ",", "4", ",", 
          RowBox[{"1", "/", "100"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"finalAveragedData", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"xGrid", ",", "averagedY"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Plot", " ", "Average"}], "*)"}], 
       RowBox[{"printPlot", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"finalAveragedData", ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<N = \>\"", ",", "Nsoliton", ",", "\"\< (Avg)\>\""}],
              "}"}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "printPlot", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Export", " ", "Average"}], "*)"}], 
       RowBox[{"fileNameAvg", "=", 
        RowBox[{
         RowBox[{"ToString", "[", "Nsoliton", "]"}], 
         "<>", "\"\<solitonPV_AVERAGED.csv\>\""}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pathAvg", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", "fileNameAvg"}], 
          "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"pathAvg", ",", "finalAveragedData"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Final Average Exported: \>\"", ",", "pathAvg"}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<---------------------------------------\>\"", "]"}],
        ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"currentN", ",", "solitonCounts"}], "}"}]}], "]"}], 
    ";"}]}]}]], "Input",
