Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "Modulus", " ", "of", " ", "the", " ",
     "Asymptotic", " ", "Solution"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"parameters", ":", 
     RowBox[{"x", " ", 
      RowBox[{"(", "space", ")"}]}]}], ",", 
    RowBox[{"nSol", " ", 
     RowBox[{"(", "N", ")"}]}], ",", 
    RowBox[{"magA", " ", 
     RowBox[{"(", 
      RowBox[{"|", "A", "|"}], ")"}]}], ",", 
    RowBox[{"theta", " ", 
     RowBox[{"(", 
      RowBox[{"Arg", 
       RowBox[{"(", "A", ")"}]}], ")"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PsiAsympMod", "[", 
      RowBox[{"x_", ",", "nSol_", ",", "magA_", ",", "theta_"}], "]"}], ":=", 
     
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "prefactor", ",", "k", ",", "m", ",", "Kval", ",", "shift", ",", "u", 
         ",", "sdVal"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"Calculate", " ", "Pre"}], "-", 
          RowBox[{"factor", " ", 
           RowBox[{"Magnitude", ":", " ", 
            RowBox[{"|", 
             RowBox[{
              RowBox[{"-", "2"}], "i", " ", "Re", 
              RowBox[{"(", "A", ")"}], "Im", 
              RowBox[{
               RowBox[{"(", "A", ")"}], "/"}]}], "|", 
             RowBox[{"A", "||"}]}]}]}]}], " ", "->", " ", 
         RowBox[{"|", "A", "|", 
          RowBox[{"*", 
           RowBox[{"|", 
            RowBox[{"Sin", 
             RowBox[{"(", 
              RowBox[{"2", " ", "theta"}], ")"}]}], "|"}]}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"prefactor", "=", 
         RowBox[{"magA", "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"Sin", "[", 
            RowBox[{"2", "*", "theta"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Setup", " ", "Elliptic", " ", "Parameters"}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Theorem", " ", "uses", " ", "k"}], "=", 
          RowBox[{
           RowBox[{"cos", 
            RowBox[{
             RowBox[{"(", "theta", ")"}], ".", "Mathematica"}], " ", "uses", " ",
             "m"}], "=", 
           RowBox[{"k", "^", "2"}]}]}], "*)"}], 
        RowBox[{"k", "=", 
         RowBox[{"Cos", "[", "theta", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"m", "=", 
         RowBox[{"k", "^", "2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Complete", " ", "Elliptic", " ", "Integral", " ", "K", 
          RowBox[{"(", "m", ")"}]}], "*)"}], 
        RowBox[{"Kval", "=", 
         RowBox[{"EllipticK", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Calculate", " ", "Argument", " ", "u", " ", "for", " ", 
          "JacobiSD"}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{"u", "=", 
          RowBox[{
           RowBox[{"-", "2"}], "|", "A", "|", 
           RowBox[{"x", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"2", " ", "K", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"cos", 
                  RowBox[{"(", "theta", ")"}]}], ")"}], "/", "pi"}]}], ")"}], 
             "*", "ln", 
             RowBox[{"(", "N", ")"}]}]}]}]}], "*)"}], 
        RowBox[{"shift", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "*", 
            RowBox[{"Kval", "/", "Pi"}]}], ")"}], "*", 
          RowBox[{"Log", "[", "nSol", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"u", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], "*", "magA", "*", "x"}], "+", "shift"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Calculate", " ", "Jacobi", " ", "SD", " ", "function"}], 
         "*)"}], 
        RowBox[{"sdVal", "=", 
         RowBox[{"JacobiSD", "[", 
          RowBox[{"u", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Return", " ", "Modulus"}], "*)"}], 
        RowBox[{"prefactor", "*", 
         RowBox[{"Abs", "[", "sdVal", "]"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Define", " ", "Test", " ", "Cases"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Format", ":", 
     RowBox[{"{", 
      RowBox[{"N", ",", " ", 
       RowBox[{"|", "A", "|"}], ",", "theta", ",", "Label"}], "}"}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cases", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"10", ",", "1.0", ",", 
         RowBox[{"Pi", "/", "4"}], 
         ",", "\"\<N=10, |A|=1, \[Theta]=\[Pi]/4\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"100", ",", "1.0", ",", 
         RowBox[{"Pi", "/", "4"}], 
         ",", "\"\<N=100, |A|=1, \[Theta]=\[Pi]/4\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"100", ",", "0.5", ",", 
         RowBox[{"Pi", "/", "4"}], 
         ",", "\"\<N=100, |A|=0.5, \[Theta]=\[Pi]/4\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"100", ",", "1.0", ",", 
         RowBox[{"Pi", "/", "6"}], 
         ",", "\"\<N=100, |A|=1, \[Theta]=\[Pi]/6\>\""}], "}"}]}], "}"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Helper", " ", "to", " ", "center", " ", "the", " ", "plot", " ", 
     "window", " ", "on", " ", "the", " ", "wave", " ", "packet"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GetCenter", "[", 
      RowBox[{"nSol_", ",", "magA_", ",", "theta_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", "Kval", ",", "shift"}], "}"}], ",", 
       RowBox[{
        RowBox[{"m", "=", 
         RowBox[{
          RowBox[{"Cos", "[", "theta", "]"}], "^", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Kval", "=", 
         RowBox[{"EllipticK", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"shift", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "*", 
            RowBox[{"Kval", "/", "Pi"}]}], ")"}], "*", 
          RowBox[{"Log", "[", "nSol", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"shift", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "magA"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Generate", " ", "Plots"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plots", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "=", 
            RowBox[{"case", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"a", "=", 
            RowBox[{"case", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"th", "=", 
            RowBox[{"case", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", 
           RowBox[{"lbl", "=", 
            RowBox[{"case", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "centerX", "}"}], ",", 
           RowBox[{
            RowBox[{"centerX", "=", 
             RowBox[{"GetCenter", "[", 
              RowBox[{"n", ",", "a", ",", "th"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Plot", "[", 
             RowBox[{
              RowBox[{"PsiAsympMod", "[", 
               RowBox[{"x", ",", "n", ",", "a", ",", "th"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", 
                RowBox[{"centerX", "-", "10"}], ",", 
                RowBox[{"centerX", "+", "10"}]}], "}"}], ",", 
              RowBox[{"(*", 
               RowBox[{"Window", "+", 
                RowBox[{
                 RowBox[{"/", 
                  RowBox[{"-", "10"}]}], " ", "around", " ", "center"}]}], 
               "*)"}], 
              RowBox[{"PlotRange", "->", "All"}], ",", 
              RowBox[{"Frame", "->", "True"}], ",", 
              RowBox[{"FrameLabel", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<x\>\"", ",", "\"\<|\[Psi]|\>\""}], "}"}]}], ",", 
              
              RowBox[{"PlotLabel", "->", 
               RowBox[{"Style", "[", 
                RowBox[{"lbl", ",", "12", ",", 
                 RowBox[{"FontFamily", "->", "\"\<Arial\>\""}]}], "]"}]}], ",", 
              RowBox[{"PlotStyle", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Thickness", "[", "0.006", "]"}], ",", 
                 RowBox[{"RGBColor", "[", 
                  RowBox[{"0", ",", "0.4", ",", "0.6"}], "]"}]}], "}"}]}], ",", 
              RowBox[{"GridLines", "->", "Automatic"}], ",", 
              RowBox[{"ImageSize", "->", "300"}]}], "]"}]}]}], "]"}]}], "]"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"case", ",", "cases"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Display"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Partition", "[", 
      RowBox[{"plots", ",", "2"}], "]"}], ",", 
     RowBox[{"Spacings", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}]}]], "Input",
