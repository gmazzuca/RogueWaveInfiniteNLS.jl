Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Define", " ", "the", " ", "Modulus", " ", "Function"}],
    "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PsiAsympMod", "[", 
      RowBox[{"x_", ",", "nSol_", ",", "magA_", ",", "theta_"}], "]"}], ":=", 
     
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "prefactor", ",", "k", ",", "m", ",", "Kval", ",", "shift", ",", "u", 
         ",", "sdVal"}], "}"}], ",", 
       RowBox[{
        RowBox[{"prefactor", "=", 
         RowBox[{"magA", "*", 
          RowBox[{"Abs", "[", 
           RowBox[{"Sin", "[", 
            RowBox[{"2", "*", "theta"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"k", "=", 
         RowBox[{"Cos", "[", "theta", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"m", "=", 
         RowBox[{"k", "^", "2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Kval", "=", 
         RowBox[{"EllipticK", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"shift", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "*", 
            RowBox[{"Kval", "/", "Pi"}]}], ")"}], "*", 
          RowBox[{"Log", "[", "nSol", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"u", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], "*", "magA", "*", "x"}], "+", "shift"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"sdVal", "=", 
         RowBox[{"JacobiSD", "[", 
          RowBox[{"u", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"prefactor", "*", 
         RowBox[{"Abs", "[", "sdVal", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Define", " ", "Cases"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cases", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"100", ",", "1.0", ",", 
         RowBox[{"Pi", "/", "4"}], 
         ",", "\"\<N=100, |A|=1, \[Theta]=\[Pi]/4\>\"", 
         ",", "\"\<N100_A1_ThPi4\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "1.0", ",", 
         RowBox[{"Pi", "/", "4"}], 
         ",", "\"\<N=1000, |A|=1, \[Theta]=\[Pi]/4\>\"", 
         ",", "\"\<N1000_A1_ThPi4\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "0.5", ",", 
         RowBox[{"Pi", "/", "4"}], 
         ",", "\"\<N=1000, |A|=0.5, \[Theta]=\[Pi]/4\>\"", 
         ",", "\"\<N1000_A05_ThPi4\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1000", ",", "1.0", ",", 
         RowBox[{"Pi", "/", "6"}], 
         ",", "\"\<N=1000, |A|=1, \[Theta]=\[Pi]/6\>\"", 
         ",", "\"\<N1000_A1_ThPi6\>\""}], "}"}]}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Helper", " ", "to", " ", "center", " ", "the", " ", "plot"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GetCenter", "[", 
      RowBox[{"nSol_", ",", "magA_", ",", "theta_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", "Kval", ",", "shift"}], "}"}], ",", 
       RowBox[{
        RowBox[{"m", "=", 
         RowBox[{
          RowBox[{"Cos", "[", "theta", "]"}], "^", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Kval", "=", 
         RowBox[{"EllipticK", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"shift", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "*", 
            RowBox[{"Kval", "/", "Pi"}]}], ")"}], "*", 
          RowBox[{"Log", "[", "nSol", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"shift", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "magA"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Generate", " ", "and", " ", "Save", " ", "Loop"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Set", " ", "the", " ", "directory", " ", "where", " ", "you", " ", 
      "want", " ", "to", " ", 
      RowBox[{"save", ".", "By"}], " ", "default"}], ",", 
     RowBox[{"this", " ", "saves", " ", "to", " ", "your", " ", 
      RowBox[{"Notebook", "'"}], "s", " ", "current", " ", 
      RowBox[{"directory", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{"case", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"a", "=", 
           RowBox[{"case", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{"th", "=", 
           RowBox[{"case", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", 
          RowBox[{"title", "=", 
           RowBox[{"case", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ",", 
          RowBox[{"fname", "=", 
           RowBox[{"case", "[", 
            RowBox[{"[", "5", "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"centerX", ",", "plt"}], "}"}], ",", 
          RowBox[{
           RowBox[{"centerX", "=", 
            RowBox[{"GetCenter", "[", 
             RowBox[{"n", ",", "a", ",", "th"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"plt", "=", 
            RowBox[{"Plot", "[", 
             RowBox[{
              RowBox[{"PsiAsympMod", "[", 
               RowBox[{"x", ",", "n", ",", "a", ",", "th"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", 
                RowBox[{"centerX", "-", "10"}], ",", 
                RowBox[{"centerX", "+", "10"}]}], "}"}], ",", 
              RowBox[{"(*", 
               RowBox[{"Styling", " ", "for", " ", "Publication"}], "*)"}], 
              RowBox[{"PlotRange", "->", "All"}], ",", 
              RowBox[{"Frame", "->", "True"}], ",", 
              RowBox[{"FrameLabel", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<x\>\"", ",", 
                   RowBox[{"FontSize", "->", "16"}], ",", 
                   RowBox[{"FontSlant", "->", "Italic"}]}], "]"}], ",", 
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<|\[Psi]|\>\"", ",", 
                   RowBox[{"FontSize", "->", "16"}], ",", 
                   RowBox[{"FontSlant", "->", "Italic"}]}], "]"}]}], "}"}]}], 
              ",", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                "If", " ", "you", " ", "prefer", " ", "NO", " ", "title", " ",
                  "inside", " ", "the", " ", "plot", " ", "for", " ", "the", " ",
                  "paper"}], ",", 
                RowBox[{"comment", " ", "out", " ", "PlotLabel"}]}], "*)"}], 
              RowBox[{"PlotLabel", "->", 
               RowBox[{"Style", "[", 
                RowBox[{"title", ",", "14", ",", 
